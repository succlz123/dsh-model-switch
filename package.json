{
  "name": "dsh-remote-model-switch",
  "version": "1.0.1",
  "description": "遥控器切换模型（全局插件版）：小米蓝牙遥控器（HID 键盘）一键切换模型与思考强度，输入框左侧 🎮 按钮。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "model-switch",
    "remote"
  ],
  "license": "MIT"
}
